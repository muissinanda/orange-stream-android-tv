<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Pure Android TV Leanback Experience -->
    <style name="Theme.OrangeStreamTV" parent="Theme.Leanback">
        <item name="defaultBrandColor">#090C13</item>
        <item name="defaultSearchColor">@color/primary_orange</item>
        <item name="android:windowBackground">#06080D</item>
        <item name="android:colorBackground">#06080D</item>
        <item name="android:colorPrimary">@color/primary_orange</item>
        <item name="android:colorPrimaryDark">#05060A</item>
        <item name="android:colorAccent">@color/accent_orange</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="rowHeaderStyle">@style/CustomRowHeaderStyle</item>
        <item name="headerStyle">@style/CustomHeaderItemStyle</item>
    </style>

    <style name="CustomRowHeaderStyle" parent="Widget.Leanback.Row.Header">
        <item name="android:textAppearance">@style/TextAppearance.RowHeader</item>
    </style>

    <style name="TextAppearance.RowHeader" parent="TextAppearance.Leanback.Row.Header">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomHeaderItemStyle" parent="Widget.Leanback.Header">
        <item name="android:textAppearance">@style/TextAppearance.HeaderItem</item>
    </style>

    <style name="TextAppearance.HeaderItem" parent="TextAppearance.Leanback.Header">
        <item name="android:textColor">#94A3B8</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.OrangeStreamTV.Playback" parent="Theme.Leanback">
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>